{
  "schema_version": 1,
  "scenario": {
    "name": "Hacking Things",
    "description": "Hacking tools, articles, and other resources.\r\n",
    "color": "#3B82F6",
    "is_active": true
  },
  "agents": [
    {
      "export_id": 0,
      "name": "Filter For Botnet/Ransomware",
      "job_type": "filter_agent",
      "config": {
        "rules": [
          {
            "type": "regex",
            "field": "title",
            "value": "ransomware|botnet"
          }
        ],
        "match_all": false
      },
      "schedule_cron": null,
      "schedule_enabled": false,
      "is_active": true,
      "priority": 0
    },
    {
      "export_id": 1,
      "name": "Filter For Vulnerability",
      "job_type": "filter_agent",
      "config": {
        "rules": [
          {
            "type": "regex",
            "field": "title",
            "value": "[vV]ulnerability"
          }
        ],
        "match_all": false
      },
      "schedule_cron": null,
      "schedule_enabled": false,
      "is_active": true,
      "priority": 0
    },
    {
      "export_id": 2,
      "name": "Hacking News RSS Cleanup",
      "job_type": "template_agent",
      "config": {
        "templates": {
          "url": "{{ url }}",
          "title": "{{ title }}",
          "authors": "{{ authors }}",
          "categories": "{{ categories }}",
          "date_published": "{{ date_published }}"
        },
        "preserve_original": false
      },
      "schedule_cron": null,
      "schedule_enabled": false,
      "is_active": true,
      "priority": 0
    },
    {
      "export_id": 3,
      "name": "Bleeping Computer",
      "job_type": "rss_agent",
      "config": {
        "feed_url": "https://www.bleepingcomputer.com/feed/"
      },
      "schedule_cron": "0 0 * * *",
      "schedule_enabled": true,
      "is_active": true,
      "priority": 0
    },
    {
      "export_id": 4,
      "name": "Filter For Cyber Security",
      "job_type": "filter_agent",
      "config": {
        "rules": [
          {
            "type": "regex",
            "field": "title",
            "value": "[cC]yber\\s[sS]ecurity"
          }
        ],
        "match_all": false
      },
      "schedule_cron": null,
      "schedule_enabled": false,
      "is_active": true,
      "priority": 0
    },
    {
      "export_id": 5,
      "name": "Filter For IoT",
      "job_type": "filter_agent",
      "config": {
        "rules": [
          {
            "type": "regex",
            "field": "title",
            "value": "I[oO]T"
          }
        ],
        "match_all": false
      },
      "schedule_cron": null,
      "schedule_enabled": false,
      "is_active": true,
      "priority": 0
    },
    {
      "export_id": 6,
      "name": "Filter For Malicious",
      "job_type": "filter_agent",
      "config": {
        "rules": [
          {
            "type": "regex",
            "field": "title",
            "value": "[mM]alicious"
          }
        ],
        "match_all": false
      },
      "schedule_cron": null,
      "schedule_enabled": false,
      "is_active": true,
      "priority": 0
    },
    {
      "export_id": 7,
