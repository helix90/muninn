# Muninn Environment Configuration
# Copy this file to .env and modify the values as needed

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Application Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
LOG_LEVEL=INFO

# Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://muninn:muninn_pass@localhost:5432/muninn_dev
TEST_DATABASE_URL=postgresql://muninn:muninn_pass@localhost:5432/muninn_test

# Database Connection Pooling
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=3600
DB_MAX_OVERFLOW=20

# Scheduler Configuration - Thundering Herd Prevention
# These settings control how the scheduler handles many jobs with identical schedules
# Jitter adds random delay (0-60s by default) to prevent all jobs firing simultaneously
SCHEDULER_JITTER_MIN=0
SCHEDULER_JITTER_MAX=60
SCHEDULER_MAX_STARTS_PER_SEC=5

# Agent Failure Reporting
# Controls how many days back the "failed runs" count looks on the agent list and detail pages.
# Failures older than this window are not counted as "recent" failures.
AGENT_FAILURE_WINDOW_DAYS=7

# SMTP Configuration (Required for Email Agents)
# Global SMTP settings used by all email agents in the system
# For Gmail: Use smtp.gmail.com with port 587 and an App Password (not your regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com

# Security Configuration
# SESSION_COOKIE_SECURE=False
# SESSION_COOKIE_HTTPONLY=True
# SESSION_COOKIE_SAMESITE=Lax

# External Services (for future use)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# Monitoring and Logging
# SENTRY_DSN=your-sentry-dsn-here
# LOG_TO_FILE=True
# LOG_FILE_PATH=logs/muninn.log 