      "schedule_cron": "0 0 * * *",
      "schedule_enabled": true,
      "is_active": true,
      "priority": 0
    },
    {
      "export_id": 8,
      "name": "Hacking News E-mailer",
      "job_type": "email_agent",
      "config": {
        "to_email": [
          "helix90@gmail.com",
          "helix@helixandvixen.com"
        ],
