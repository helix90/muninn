# Muninn Environment Configuration
# Copy this file to .env and modify the values as needed
# .env is gitignored — never commit real secrets.

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Application Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
LOG_LEVEL=INFO

# Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://muninn:muninn_pass@localhost:5432/muninn_dev
TEST_DATABASE_URL=postgresql://muninn:muninn_pass@localhost:5432/muninn_test

# Database Connection Pooling
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=3600
DB_MAX_OVERFLOW=20

# Scheduler Configuration - Thundering Herd Prevention
# These settings control how the scheduler handles many jobs with identical schedules
# Jitter adds random delay (0-60s by default) to prevent all jobs firing simultaneously
SCHEDULER_JITTER_MIN=0
SCHEDULER_JITTER_MAX=60
SCHEDULER_MAX_STARTS_PER_SEC=5

# Agent Failure Reporting
# Controls how many days back the "failed runs" count looks on the agent list and detail pages.
# Failures older than this window are not counted as "recent" failures.
AGENT_FAILURE_WINDOW_DAYS=7

# ──────────────────────────────────────────────────────────────────────────────
# SMTP Configuration (Required for Email Agents)
# Global SMTP settings used by all email agents in the system.
# ──────────────────────────────────────────────────────────────────────────────
#
# Two connection modes — pick one based on your provider:
#
#   STARTTLS (most common, port 587)
#     SMTP_PORT=587
#     SMTP_USE_TLS=True
#
#   Implicit SSL (port 465 — use this if STARTTLS gives a 454 error)
#     SMTP_PORT=465
#     SMTP_USE_TLS=False
#
# ── Gmail ──────────────────────────────────────────────────────────────────
# Requires an App Password (not your account password):
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create a password for "Mail" and paste it below
#
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=you@gmail.com
#
# ── Outlook / Microsoft 365 ────────────────────────────────────────────────
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=True
# SMTP_USERNAME=you@yourdomain.com
# SMTP_PASSWORD=your-password
# SMTP_FROM_EMAIL=you@yourdomain.com
#
# ── SendGrid ───────────────────────────────────────────────────────────────
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USE_TLS=True
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM_EMAIL=you@yourdomain.com
#
# ── Mailgun ────────────────────────────────────────────────────────────────
# SMTP_SERVER=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USE_TLS=True
# SMTP_USERNAME=postmaster@your-mailgun-domain
# SMTP_PASSWORD=your-mailgun-smtp-password
# SMTP_FROM_EMAIL=you@your-mailgun-domain
#
# ── Generic provider using implicit SSL (port 465) ─────────────────────────
# SMTP_SERVER=mail.yourprovider.com
# SMTP_PORT=465
# SMTP_USE_TLS=False
# SMTP_USERNAME=you@yourprovider.com
# SMTP_PASSWORD=your-password
# SMTP_FROM_EMAIL=you@yourprovider.com

# ──────────────────────────────────────────────────────────────────────────────
# Docker Compose Overrides
# These are only needed when running via docker-compose.
# All three have sensible defaults in docker-compose.yml and can be left unset.
# ──────────────────────────────────────────────────────────────────────────────
# MUNINN_PORT=5000        # host port mapped to the app container
# POSTGRES_PORT=5432      # host port mapped to the postgres container
# POSTGRES_PASSWORD=muninn_pass

# Security Configuration
# SESSION_COOKIE_SECURE=False
# SESSION_COOKIE_HTTPONLY=True
# SESSION_COOKIE_SAMESITE=Lax

# External Services (for future use)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# Monitoring and Logging
# SENTRY_DSN=your-sentry-dsn-here
# LOG_TO_FILE=True
# LOG_FILE_PATH=logs/muninn.log
